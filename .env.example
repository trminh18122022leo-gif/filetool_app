# ══════════════════════════════════════════════════════════════════════════════
# FileTools Pro — Biến Môi Trường (Environment Variables)
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/filetools?retryWrites=true&w=majority

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudflare R2 (S3-compatible Object Storage) ──────────────────────────────
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=filetools-outputs
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# ── Stripe (Payment Gateway) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxxxxxx

# ── Email SMTP (Brevo / SendGrid / Gmail) ────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@domain.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="FileTools Pro <noreply@filetools.pro>"

# ── 1. Google Gemini AI (PRIMARY - 100% FREE TIER) ───────────────────────────
# Lấy miễn phí tại: https://aistudio.google.com -> Get API Key
GOOGLE_AI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# ── 2. Groq Cloud AI (FREE BACKUP & ULTRA FAST) ──────────────────────────────
# Lấy miễn phí tại: https://console.groq.com/keys
# Hỗ trợ Llama 3.3 70B, Llama 3.1 8B tốc độ 500+ tokens/giây hoàn toàn miễn phí
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── 3. OpenRouter Free Tier (TÙY CHỌN FALLBACK) ──────────────────────────────
# Lấy miễn phí tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Remove.bg API (TÙY CHỌN) ─────────────────────────────────────────────────
# Để trống = dùng local AI (@imgly) miễn phí
REMOVEBG_API_KEY=

# ── OAuth ─────────────────────────────────────────────────────
SERVER_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#MICROSOFT_CLIENT_ID=
#MICROSOFT_CLIENT_SECRET=

# ── Feature Flags ─────────────────────────────────────────────
FREE_MODE=true
VITE_HIDE_PRICING=true
