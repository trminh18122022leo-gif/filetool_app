# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3001

# ==============================================================================
# DATABASE CONFIGURATION (MONGODB)
# ==============================================================================
MONGODB_URI=mongodb://localhost:27017/filetools
# MONGODB_AUTH_URI=mongodb://...
# MONGODB_DATA_URI=mongodb://...

# ==============================================================================
# SECURITY & AUTHENTICATION (JWT)
# ==============================================================================
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# STORAGE & S3 / CLOUDFLARE R2
# ==============================================================================
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=filetools
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# ==============================================================================
# AI PROVIDERS (OPTIONAL)
# ==============================================================================
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
REMOVE_BG_API_KEY=

# ==============================================================================
# PAYMENTS (STRIPE)
# ==============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ==============================================================================
# EMAIL (SMTP / NODEMAILER)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FileTools Support" <support@filetools.example.com>

# ==============================================================================
# APP SETTINGS & LIMITS
# ==============================================================================
MAX_FILE_SIZE_MB=50
FILE_RETENTION_HOURS=24
FREE_MODE=false
VITE_HIDE_PRICING=false

# ==============================================================================
# OAUTH 2.0 (GOOGLE, GITHUB, TELEGRAM)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
