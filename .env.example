# ==============================================================================
# FILETOOLS PRO — ENVIRONMENT MANIFEST & CONFIGURATION TEMPLATE
# ==============================================================================
# Guidelines:
# 1. Distinguishes REQUIRED, OPTIONAL, and FEATURE-GATED variables.
# 2. Never commit actual secret keys, production connection strings, or PII.
# 3. For Staging environment, set APP_ENV=staging and configure dedicated staging resources.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & ENVIRONMENT IDENTIFIERS [REQUIRED]
# ------------------------------------------------------------------------------
PORT=3001
# Node environment (development | test | production)
NODE_ENV=development
# Application environment identifier (development | test | staging | production)
# When set to 'staging', production security invariants are enforced with isolated staging services.
APP_ENV=development

# ------------------------------------------------------------------------------
# 2. CLIENT ORIGINS & CORS CONFIGURATION [REQUIRED]
# ------------------------------------------------------------------------------
# Primary client origin for web redirects, OAuth callbacks, and CORS allowlisting
CLIENT_URL=http://localhost:5173
# Dedicated staging client origin (Required in Staging environment)
# Example: https://filetool-app-git-staging.vercel.app
STAGING_CLIENT_URL=
# Comma-separated list of additional explicitly authorized origins for credentialed CORS
# Localhost origins are automatically rejected in staging and production modes.
ALLOWED_ORIGINS=https://filetool-app.vercel.app,https://filetools-app.vercel.app,https://filetools.pro

# Server public base URL
SERVER_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION — DUAL-CLUSTER ISOLATION [REQUIRED]
# ------------------------------------------------------------------------------
# Single-cluster fallback (Development only)
MONGODB_URI=mongodb://localhost:27017/filetools

# Dual-Cluster Enterprise Architecture (Required for Staging & Production):
# Dedicated Auth Cluster for users, tokens, credentials, sessions, and audit logs
AUTH_DB_URI=
# Dedicated Data Cluster for workspaces, files, workflows, and job metadata
DATA_DB_URI=

# ------------------------------------------------------------------------------
# 4. DURABLE QUEUE & CACHE — REDIS / BULLMQ [REQUIRED IN STAGING/PROD]
# ------------------------------------------------------------------------------
# Redis TLS connection URL for BullMQ distributed job processing and rate limiting.
# In Staging and Production, app fails closed if queue is unreachable (no silent in-memory fallback).
# Example: rediss://default:password@staging-redis.upstash.io:6379
REDIS_URL=

# Logical Isolation Options (Allows reusing a single Redis instance between Staging and Production):
# BULLMQ_QUEUE_NAME: Queue identifier (defaults to 'filetools-jobs', use 'filetools-jobs-staging' for staging)
BULLMQ_QUEUE_NAME=filetools-jobs
# BULLMQ_PREFIX: Key prefix namespace (optional, e.g. 'filetools_staging')
# BULLMQ_PREFIX=filetools_staging
WORKER_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 5. SECURITY & AUTHENTICATION SECRETS [REQUIRED]
# ------------------------------------------------------------------------------
# Cryptographically random JWT signing secrets (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE — CLOUDFLARE R2 [REQUIRED IN STAGING/PROD]
# ------------------------------------------------------------------------------
# Cloudflare R2 / S3-compatible private storage endpoint
# Format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
# Name of the dedicated private bucket (e.g. filetools-staging vs filetools-prod)
R2_BUCKET_NAME=filetools
# All downloads are served via authenticated short-lived presigned URLs.
# Public bucket access and R2_PUBLIC_URL are strictly prohibited.

# ------------------------------------------------------------------------------
# 7. BYOK ENVELOPE ENCRYPTION KEY VAULT [REQUIRED FOR AI SERVICES]
# ------------------------------------------------------------------------------
# 32-byte hexadecimal secret (64 characters) used for AES-256-GCM BYOK credential encryption
AI_KEY_VAULT_SECRET=

# ------------------------------------------------------------------------------
# 8. BILLING & PAYMENTS GATEWAY [FEATURE-GATED]
# ------------------------------------------------------------------------------
# Master billing safety toggle. MUST remain 'false' until commercial go-live approval.
BILLING_ENABLED=false
# Sandbox/test keys when testing payment integration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ------------------------------------------------------------------------------
# 9. HTML/URL RENDERER & SSRF SAFETY [FEATURE-GATED]
# ------------------------------------------------------------------------------
# Disables URL-to-PDF by default to prevent SSRF vulnerabilities. Set 'true' only when approved.
ENABLE_URL_TO_PDF=false
# Chromium sandbox override (Leave false; only set true if host kernel lacks unprivileged user namespaces AND ALLOW_SANDBOX_FALLBACK=true)
CHROMIUM_NO_SANDBOX=false
ALLOW_SANDBOX_FALLBACK=false

# ------------------------------------------------------------------------------
# 10. AI PROVIDERS [OPTIONAL]
# ------------------------------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
REMOVE_BG_API_KEY=

# ------------------------------------------------------------------------------
# 11. EMAIL & NOTIFICATIONS [OPTIONAL]
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FileTools Support" <support@filetools.example.com>

# ------------------------------------------------------------------------------
# 12. APP LIMITS & CLIENT SETTINGS [OPTIONAL]
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=50
FILE_RETENTION_HOURS=24
FREE_MODE=false
VITE_HIDE_PRICING=false

# ------------------------------------------------------------------------------
# 13. OAUTH 2.0 INTEGRATIONS [OPTIONAL]
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
