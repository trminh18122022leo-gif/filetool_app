{
  "appId": "com.filetools.pro",
  "appName": "FileTools Pro",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "allowNavigation": [
      "filetools-app.vercel.app",
      "filetools-jkx7.onrender.com",
      "accounts.google.com",
      "github.com"
    ],
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#08080C",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "spinnerColor": "#f59e0b"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#08080C"
    }
  }
}
