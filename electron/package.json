{
  "name": "filetools-pro",
  "version": "1.0.0",
  "description": "Nền tảng xử lý file tốc độ cao & bảo mật",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "publish": "electron-builder --win -p always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "electron-serve": "^1.3.0"
  },
  "build": {
    "appId": "com.filetools.pro",
    "productName": "FileTools Pro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "publish": [
        {
          "provider": "github",
          "owner": "YOUR_GITHUB_USERNAME",
          "repo": "YOUR_REPO_NAME"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FileTools Pro"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
