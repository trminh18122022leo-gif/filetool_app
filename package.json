{
  "name": "filetools-app",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon --config nodemon.json server/index.js",
    "client": "npm --prefix client run dev",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev\" \"npm run client\"",
    "build": "cd client && npm run build",
    "test": "node scripts/verify-syntax.cjs",
    "clean": "node -e \"const fs=require('fs');['uploads','outputs'].forEach(d=>{if(fs.existsSync(d))fs.readdirSync(d).forEach(f=>fs.unlinkSync(d+'/'+f))})\"",
    "electron:dev": "npm run build && cd electron && npm start",
    "electron:build": "npm run build && cd electron && npm install && npm run build"
  },
  "allowScripts": {
    "sharp": true,
    "puppeteer": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@imgly/background-removal-node": "^1.4.5",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "express-slow-down": "^3.1.1",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.10",
    "p-queue": "^9.3.3",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^25.11.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "stripe": "^22.6.2",
    "unzipper": "^0.12.3",
    "uuid": "^14.0.2",
    "winston": "^3.17.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  }
}
