{
  "name": "filetools-app",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "worker": "node server/worker.js",
    "dev": "nodemon --config nodemon.json server/index.js",
    "client": "npm --prefix client run dev",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev\" \"npm run client\"",
    "build": "cd client && npm run build",
    "test": "node scripts/verify-syntax.cjs",
    "test:security": "node --test tests/security/auth-access.test.js tests/security/file-storage.test.js tests/security/redact-render.test.js",
    "test:reliability": "node --test tests/reliability/job-system.test.js",
    "test:fidelity": "node --test tests/fidelity/pdf-fidelity.test.js",
    "test:workflows": "node --test tests/integration/workflow-workspace.test.js",
    "test:ai": "node --test tests/ai/ai-evals.test.js",
    "test:billing": "node --test tests/billing/subscription-finops.test.js",
    "test:seo": "node --test tests/seo-pwa/seo-pwa-perf.test.js",
    "test:windows": "node --test tests/releases/windows-release.test.js",
    "test:staging": "node --test tests/staging/environment-isolation.test.js tests/security/cors-hardening.test.js tests/security/renderer-security.test.js",
    "test:all": "node scripts/verify-syntax.cjs && node --test tests/security/auth-access.test.js tests/security/file-storage.test.js tests/security/redact-render.test.js tests/reliability/job-system.test.js tests/fidelity/pdf-fidelity.test.js tests/integration/workflow-workspace.test.js tests/ai/ai-evals.test.js tests/billing/subscription-finops.test.js tests/seo-pwa/seo-pwa-perf.test.js tests/releases/windows-release.test.js tests/staging/environment-isolation.test.js tests/security/cors-hardening.test.js tests/security/renderer-security.test.js",
    "clean": "node -e \"const fs=require('fs');['uploads','outputs'].forEach(d=>{if(fs.existsSync(d))fs.readdirSync(d).forEach(f=>fs.unlinkSync(d+'/'+f))})\"",
    "benchmark": "node scripts/load-benchmark.js",
    "electron:dev": "npm run build && cd electron && npm start",
    "electron:build": "npm run build && cd electron && npm install && npm run build"
  },
  "allowScripts": {
    "sharp": true,
    "puppeteer": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.714.0",
    "@aws-sdk/s3-request-presigner": "^3.714.0",
    "@imgly/background-removal-node": "^1.4.5",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.4.0",
    "bwip-js": "^4.11.4",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^3.1.1",
    "express-validator": "^7.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "marked": "^18.0.11",
    "mongoose": "^8.9.3",
    "msedge-tts": "^2.0.8",
    "multer": "^2.0.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.16",
    "p-queue": "^8.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "potrace": "^2.1.8",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^24.2.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "stripe": "^17.5.0",
    "unzipper": "^0.12.3",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14"
  }
}
